# ===== Voalle + BFF (server-side only) =====
# Copie este arquivo para .env e preencha com seus dados reais.
VOALLE_AUTH_URL=https://SEU-ERP:45700/connect/token
VOALLE_BASE_URL=https://SEU-ERP:45715

VOALLE_GRANT_TYPE=client_credentials
VOALLE_SCOPE=syngw
VOALLE_CLIENT_ID=SEU_CLIENT_ID
VOALLE_CLIENT_SECRET=SEU_CLIENT_SECRET
VOALLE_SYNDATA=SEU_SYNDATA

# JWT do BFF (mude em produção)
JWT_SECRET=dev_secret_change_me

# Porta do BFF
PORT=3000

# ===== Frontend (Vite) =====
# opcional: se o BFF não estiver no mesmo host/porta do Vite (proxy), use:
# VITE_BFF_BASE_URL=http://localhost:3000
